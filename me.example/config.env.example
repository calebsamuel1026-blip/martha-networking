# me/config.env : your Gmail login for sending and for checking replies.
#
# You fill this in YOURSELF, in a text editor (Notepad on Windows, TextEdit on a Mac).
# Never paste your password into the Claude Code chat. Claude never opens or prints this file.
# This file stays on your computer: me/ is gitignored and never committed.
#
# How to make a Gmail app password (about 3 minutes):
#   1. Use a personal Gmail account. School accounts usually block app passwords.
#   2. Turn on 2-Step Verification: https://myaccount.google.com/security
#   3. Go to https://myaccount.google.com/apppasswords
#      Type a name like "martha" and click Create.
#   4. Google shows a 16-letter password once. Copy it.
#   5. Copy this file to me/config.env (or /onboard does it for you).
#      Type your full Gmail address after GMAIL_ADDRESS=
#      Paste the 16 letters after GMAIL_APP_PASSWORD= with no spaces and no quotes.
#   6. Save. Then test with:  python tools/send_approved.py --test-login   (sends nothing)
#
# Lost it or pasted it somewhere by mistake? Delete that app password at the same page and make a new one.
# The app password only works for this tool. It is not your Google password, and you can revoke it any time.

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Most first emails you can send per day. 40 is a safe default for an older, active Gmail account.
# If the account is new or rarely used, start at 15 to 20 and raise it after a week with no bounces.
DAILY_CAP=40
